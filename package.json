    "@fontsource/barlow-condensed": "5.1.0",
    "@fontsource/cormorant-garamond": "5.1.0",
    "phaser": "3.88.2"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}